# =====================================================================
# DocuAsist — Variables de entorno
# =====================================================================
# Copia este fichero como .env y rellena los valores reales.
# El fichero .env NO se sube al repositorio (está en .gitignore).
# =====================================================================

# --- Ollama (servidor con GPU que ejecuta los modelos) ---
# Para desarrollo local en la misma máquina:
OLLAMA_BASE_URL=http://localhost:11434
# Para Ollama remoto en otro equipo de la red local:
# OLLAMA_BASE_URL=http://192.168.1.X:11434

# --- Modelos de lenguaje ---
LLM_MODEL=qwen3:14b-nothink
CONTEXT_MODEL=qwen3:14b-nothink
EMBED_MODEL=qwen3-embedding:8b

# --- ChromaDB (base vectorial) ---
# Para Docker Compose, usar el nombre del servicio (chroma).
# Para desarrollo local sin Docker, usar localhost.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_PRIVATE=documentos_privados
CHROMA_COLLECTION_PUBLIC=normativa_publica

# --- SQLite ---
SQLITE_PATH=./storage/tfg.db

# --- Autenticación (OBLIGATORIO rellenar) ---
# Generar un secreto fuerte: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_GENERADO_ALEATORIAMENTE
# Contraseña del usuario administrador inicial
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASEÑA_FUERTE
